<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Apply to MEET' %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <nav class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">MEET <span>apply</span></a>
      <div class="nav-links">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="/calls">Calls</a>
          <a href="/export/student">Export</a>
          <a href="/visualize/instructor/table">Visualize</a>
          <span class="who"><%= currentUser %></span>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
        <% } %>
      </div>
    </div>
  </nav>
  <main class="container">
