<%- include('../partials/head') %>
<% pageTitle = 'Matrix — ' + call.title; %>
<h1>Scatterplot matrix — <%= call.title %></h1>
<%
  const cols = numericCols.filter(c => c.type === 'integer');
  const pad = 24, size = 220, max = 7;
  const sx = (v, w) => pad + (v / max) * (w - 2 * pad);
  const sy = (v, h) => h - pad - (v / max) * (h - 2 * pad);
  const pts = summaries.filter(s => s.summary);
%>
<div class="splom">
  <% cols.forEach(function (yc, yi) { %>
    <% cols.forEach(function (xc, xi) { %>
      <div class="splom-cell">
        <svg viewBox="0 0 <%= size %> <%= size %>" class="chart" role="img">
          <% if (xi === 0) { %><text x="8" y="<%= size / 2 %>" transform="rotate(-90 8 <%= size / 2 %>)" text-anchor="middle" class="axis-label-sm"><%= reviewClass.labelOf(yc) %></text><% } %>
          <% if (yi === cols.length - 1) { %><text x="<%= size / 2 %>" y="<%= size - 6 %>" text-anchor="middle" class="axis-label-sm"><%= reviewClass.labelOf(xc) %></text><% } %>
          <% pts.forEach(function (p) { %>
            <circle cx="<%= sx(p.summary[xc.name], size) %>" cy="<%= sy(p.summary[yc.name], size) %>" r="4" class="dot" />
          <% }) %>
        </svg>
      </div>
    <% }) %>
  <% }) %>
</div>
<p class="muted"><a href="/visualize/<%= call.id %>/table">table</a> · <a href="/visualize/<%= call.id %>/scatter">scatter</a> · <a href="/review/<%= call.id %>">reviews</a></p>
<%- include('../partials/foot') %>
